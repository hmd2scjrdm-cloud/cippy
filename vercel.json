{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin-products",
      "destination": "/admin-products.html"
    },
    {
      "source": "/((?!api/|admin|admin-products).*)",
      "destination": "/maintenance.html"
    }
  ]
}


